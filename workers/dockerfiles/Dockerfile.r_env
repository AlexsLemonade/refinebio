ARG DOCKERHUB_REPO
ARG BASE_TAG
ARG WORKER
FROM $DOCKERHUB_REPO/dr_base:$BASE_TAG

# Fail in case of an error at any stage in the pipe.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

WORKDIR /home/user

COPY workers/R/dependencies/$WORKER/renv.lock .
COPY common/R/renv_load.R .
RUN Rscript renv_load.R

ENTRYPOINT []
